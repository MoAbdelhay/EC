{
  "name": "engineers-calculator-app",
  "version": "1.0.0",
  "private": true,
  "description": "Engineer's Calculator (حاسبة المهندس) by Benchmark Guides: Android and iOS app",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "build:icons": "node scripts/make-icon-sources.mjs && capacitor-assets generate --iconBackgroundColor \"#16212B\" --iconBackgroundColorDark \"#16212B\" --splashBackgroundColor \"#16212B\" --splashBackgroundColorDark \"#16212B\"",
    "sync": "npm run build:web && cap sync",
    "android:debug": "npm run sync && cd android && gradlew.bat assembleDebug",
    "android:release": "npm run sync && cd android && gradlew.bat bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2"
  }
}
